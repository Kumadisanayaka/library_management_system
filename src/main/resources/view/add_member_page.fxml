<?xml version="1.0" encoding="UTF-8"?>

<?import java.lang.String?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<AnchorPane prefHeight="581.0" prefWidth="922.0" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="controller.addMemberController.Add_member_page_controller">
   <children>
      <BorderPane prefHeight="606.0" prefWidth="922.0" styleClass="add-member-root" stylesheets="@../css/add_member_page.css">
         <left>
            <VBox prefHeight="606.0" prefWidth="233.0" styleClass="sidebar" BorderPane.alignment="CENTER">
               <children>
                  <Label styleClass="logo-title" text="Library System" />
                  <VBox prefHeight="362.0" prefWidth="197.0" styleClass="navigation-menu">
                     <children>
                        <Button fx:id="btnDashboard" mnemonicParsing="false" onAction="#btnDashboardOnAction" prefHeight="26.0" prefWidth="171.0" styleClass="nav-button" text="Dashboard" />
                        <Button fx:id="btnAddBook" mnemonicParsing="false" onAction="#btnAddBookOnAction" prefHeight="26.0" prefWidth="171.0" styleClass="nav-button" text="Add Book" />
                        <Button fx:id="btnViewBooks" layoutX="10.0" layoutY="10.0" mnemonicParsing="false" onAction="#btnViewBooksOnAction" prefHeight="26.0" prefWidth="171.0" styleClass="nav-button" text="View Books" />
                        <Button fx:id="btnAddMember" layoutX="10.0" layoutY="42.0" mnemonicParsing="false" onAction="#btnAddMemberOnAction" prefHeight="26.0" prefWidth="170.0" styleClass="nav-button-active" text="Add Member" />
                        <Button fx:id="btnManageMembers" layoutX="10.0" layoutY="74.0" mnemonicParsing="false" onAction="#btnManageMembersOnAction" prefHeight="26.0" prefWidth="170.0" styleClass="nav-button" text="Manage Members" />
                        <Button fx:id="btnIssueBook" layoutX="10.0" layoutY="106.0" mnemonicParsing="false" onAction="#btnIssueBookOnAction" prefHeight="26.0" prefWidth="170.0" styleClass="nav-button" text="Issue Book" />
                        <Button fx:id="btnReturnBook" layoutX="10.0" layoutY="138.0" mnemonicParsing="false" onAction="#btnReturnBookOnAction" prefHeight="26.0" prefWidth="170.0" styleClass="nav-button" text="Return Book" />
                        <Button fx:id="btnHistory" layoutX="10.0" layoutY="170.0" mnemonicParsing="false" onAction="#btnHistoryOnAction" prefHeight="26.0" prefWidth="170.0" styleClass="nav-button" text="History" />
                     </children>
                  </VBox>
                  <Button fx:id="btnLogout" mnemonicParsing="false" onAction="#btnLogoutOnAction" prefHeight="26.0" prefWidth="170.0" styleClass="logout-button" text="Logout" />
               </children>
            </VBox>
         </left>
         <center>
            <VBox prefHeight="200.0" prefWidth="100.0" styleClass="content-area" BorderPane.alignment="CENTER">
               <children>
                  <HBox prefHeight="74.0" prefWidth="618.0" styleClass="top-bar">
                     <children>
                        <VBox prefHeight="74.0" prefWidth="252.0" styleClass="page-header">
                           <children>
                              <Label styleClass="page-title" text="Add Member" />
                              <Label styleClass="page-subtitle" text="Enter member details to add to the library" />
                           </children>
                        </VBox>
                        <Region prefHeight="74.0" prefWidth="118.0" />
                        <HBox prefHeight="100.0" prefWidth="200.0" styleClass="admin-profile">
                           <children>
                              <Label styleClass="admin-avatar" text="A" />
                              <VBox alignment="CENTER_LEFT" prefHeight="58.0" prefWidth="153.0" styleClass="admin-info">
                                 <children>
                                    <Label styleClass="admin-name" text="Admin" />
                                    <Label alignment="CENTER" styleClass="admin-role" text="Administrator" />
                                 </children>
                              </VBox>
                           </children>
                        </HBox>
                     </children>
                  </HBox>
                  <VBox prefHeight="383.0" prefWidth="618.0" styleClass="member-form">
                     <children>
                        <HBox prefHeight="58.0" prefWidth="561.0" styleClass="form-row">
                           <children>
                              <VBox prefHeight="58.0" prefWidth="234.0" styleClass="form-field">
                                 <children>
                                    <Label styleClass="field-label" text="Full Name" />
                                    <TextField fx:id="txtFullName" promptText="Enter Full Name" styleClass="input-field" />
                                    <Label fx:id="lblFullNameError" prefHeight="17.0" prefWidth="235.0" styleClass="error-label" />
                                 </children>
                              </VBox>
                              <VBox prefHeight="89.0" prefWidth="286.0" styleClass="form-field">
                                 <children>
                                    <Label styleClass="field-label" text="Member ID" />
                                    <TextField fx:id="txtMemberId" promptText="Click Generate Member ID" styleClass="input-field" />
                                    <Label prefHeight="18.0" prefWidth="282.0" styleClass="error-label" />
                                    <Button fx:id="btnGenerateMemberId" mnemonicParsing="false" onAction="#btnGenerateMemberIdOnAction" styleClass="generate-member-id-button" text="Generate Member ID" />
                                 </children>
                              </VBox>
                           </children>
                        </HBox>
                        <HBox prefHeight="100.0" prefWidth="200.0" styleClass="form-row">
                           <children>
                              <VBox prefHeight="97.0" prefWidth="183.0" styleClass="form-field">
                                 <children>
                                    <Label styleClass="field-label" text="Membership Category" />
                                    <ComboBox fx:id="cmbMemberCategory" prefHeight="50.0" prefWidth="223.0" styleClass="input-field" />
                                    <Label prefHeight="17.0" prefWidth="234.0" styleClass="error-label" />
                                 </children>
                              </VBox>
                              <Region prefHeight="97.0" prefWidth="27.0" />
                              <VBox prefHeight="97.0" prefWidth="290.0" styleClass="form-field">
                                 <children>
                                    <Label styleClass="field-label" text="Email" />
                                    <TextField fx:id="txtEmail" prefHeight="42.0" prefWidth="283.0" promptText="Enter Email" styleClass="input-field" />
                                    <Label fx:id="lblEmailError" prefHeight="17.0" prefWidth="282.0" styleClass="error-label" />
                                 </children>
                              </VBox>
                           </children>
                        </HBox>
                        <HBox prefHeight="77.0" prefWidth="561.0" styleClass="form-row">
                           <children>
                              <VBox prefHeight="78.0" prefWidth="237.0" styleClass="form-field">
                                 <children>
                                    <Label styleClass="field-label" text="Phone Number" />
                                    <TextField fx:id="txtPhoneNumber" promptText="Enter Phone Number" styleClass="input-field" />
                                    <Label fx:id="lblPhoneNumberError" prefHeight="18.0" prefWidth="243.0" styleClass="error-label" />
                                 </children>
                              </VBox>
                              <VBox prefHeight="89.0" prefWidth="283.0" styleClass="form-field">
                                 <children>
                                    <Label styleClass="field-label" text="Address" />
                                    <TextField fx:id="txtAddress" alignment="TOP_LEFT" promptText="Enter Address">
                                       <styleClass>
                                          <String fx:value="input-field" />
                                          <String fx:value="address-field" />
                                       </styleClass></TextField>
                                    <Label fx:id="lblAddressError" prefHeight="18.0" prefWidth="280.0" styleClass="error-label" />
                                 </children>
                              </VBox>
                           </children>
                        </HBox>
                        <HBox prefHeight="100.0" prefWidth="200.0" styleClass="form-buttons">
                           <children>
                              <Region prefHeight="90.0" prefWidth="310.0" />
                              <Button fx:id="btnAdd" mnemonicParsing="false" onAction="#btnAddOnAction" styleClass="primary-button" text="Add Member" />
                              <Button fx:id="btnReset" mnemonicParsing="false" onAction="#btnResetOnAction" styleClass="secondary-button" text="Reset" />
                           </children>
                        </HBox>
                     </children>
                  </VBox>
               </children>
            </VBox>
         </center>
      </BorderPane>
   </children>
</AnchorPane>
