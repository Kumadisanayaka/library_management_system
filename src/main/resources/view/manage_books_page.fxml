<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>


<AnchorPane prefHeight="613.0" prefWidth="991.0" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="controller.manageBooksController.Manage_books_controller">
   <children>
      <BorderPane prefHeight="614.0" prefWidth="1130.0" styleClass="manage-books-root" stylesheets="@../css/manage_book_page.css">
         <left>
            <VBox prefHeight="614.0" prefWidth="250.0" styleClass="sidebar" BorderPane.alignment="CENTER">
               <children>
                  <Label alignment="CENTER" contentDisplay="CENTER" styleClass="logo-title" text="Library System" />
                  <VBox prefHeight="200.0" prefWidth="100.0" styleClass="navigation-menu">
                     <children>
                        <Button fx:id="btnDashboard" mnemonicParsing="false" onAction="#btnDashboardOnAction" prefHeight="23.0" prefWidth="190.0" styleClass="nav-button" text="Dashboard" />
                        <Button fx:id="btnAddBook" layoutX="10.0" layoutY="10.0" mnemonicParsing="false" onAction="#btnAddBookOnAction" prefHeight="23.0" prefWidth="190.0" styleClass="nav-button" text="Add Book" />
                        <Button fx:id="btnViewBooks" layoutX="10.0" layoutY="40.0" mnemonicParsing="false" onAction="#btnViewBooksOnAction" prefHeight="23.0" prefWidth="190.0" styleClass="nav-button" text="View Books" />
                        <Button fx:id="btnAddMember" layoutX="10.0" layoutY="69.0" mnemonicParsing="false" onAction="#btnAddMemberOnAction" prefHeight="23.0" prefWidth="190.0" styleClass="nav-button" text="Add Member" />
                        <Button fx:id="btnManageMembers" layoutX="10.0" layoutY="99.0" mnemonicParsing="false" onAction="#btnManageMembersOnAction" prefHeight="23.0" prefWidth="190.0" styleClass="nav-button" text="Manage Members" />
                        <Button fx:id="btnManageBooks" layoutX="10.0" layoutY="128.0" mnemonicParsing="false" onAction="#btnManageBooksOnAction" prefHeight="23.0" prefWidth="190.0" styleClass="nav-button-active" text="Manage Books" />
                        <Button fx:id="btnIssueBook" layoutX="10.0" layoutY="158.0" mnemonicParsing="false" onAction="#btnIssueBookOnAction" prefHeight="23.0" prefWidth="190.0" styleClass="nav-button" text="Issue Book" />
                        <Button fx:id="btnReturnBook" layoutX="10.0" layoutY="188.0" mnemonicParsing="false" onAction="#btnReturnBookOnAction" prefHeight="23.0" prefWidth="190.0" styleClass="nav-button" text="Return Book" />
                        <Button fx:id="btnHistory" layoutX="10.0" layoutY="217.0" mnemonicParsing="false" onAction="#btnHistoryOnAction" prefHeight="23.0" prefWidth="190.0" styleClass="nav-button" text="History" />
                     </children>
                  </VBox>
                  <Button fx:id="btnLogout" mnemonicParsing="false" onAction="#btnLogoutOnAction" prefHeight="23.0" prefWidth="190.0" styleClass="logout-button" text="Logout" />
               </children>
            </VBox>
         </left>
         <center>
            <VBox prefHeight="200.0" prefWidth="100.0" styleClass="content-area" BorderPane.alignment="CENTER">
               <children>
                  <HBox prefHeight="69.0" prefWidth="830.0" styleClass="top-bar">
                     <children>
                        <VBox prefHeight="100.0" prefWidth="253.0" styleClass="page-header">
                           <children>
                              <Label styleClass="page-title" text="Manage Books" />
                              <Label styleClass="page-subtitle" text="View and manage library books" />
                           </children>
                        </VBox>
                        <Region prefHeight="100.0" prefWidth="286.0" />
                        <HBox prefHeight="68.0" prefWidth="278.0" styleClass="admin-profile">
                           <children>
                              <Label styleClass="admin-avatar" text="A" />
                              <VBox alignment="CENTER_LEFT" prefHeight="84.0" prefWidth="219.0" styleClass="admin-info">
                                 <children>
                                    <Label styleClass="admin-name" text="Admin" />
                                    <Label styleClass="admin-role" text="Administrator" />
                                 </children>
                              </VBox>
                           </children>
                        </HBox>
                     </children>
                  </HBox>
                  <HBox prefHeight="100.0" prefWidth="200.0" styleClass="book-search-bar">
                     <children>
                        <TextField fx:id="txtSearchField" onKeyTyped="#txtSearchFieldTypingOnAction" prefWidth="353.0" promptText="Search by book ID, title or author..." styleClass="search-field" />
                        <Region prefHeight="66.0" prefWidth="16.0" />
                        <Button fx:id="btnSearch" mnemonicParsing="false" onAction="#btnSearchOnAction" styleClass="search-button" text="Search" />
                        <Region prefHeight="66.0" prefWidth="15.0" />
                        <ComboBox fx:id="cmbBookCategories" prefWidth="203.0" styleClass="filter-combo" />
                        <Region prefHeight="66.0" prefWidth="18.0" />
                        <Button fx:id="btnResetFilters" mnemonicParsing="false" onAction="#btnResetFiltersOnAction" styleClass="reset-filter-button" text="Reset Filters" />
                     </children>
                  </HBox>
                  <HBox prefHeight="100.0" prefWidth="200.0" styleClass="book-summary">
                     <children>
                        <VBox prefHeight="100.0" prefWidth="275.0" styleClass="summary-card">
                           <children>
                              <Label styleClass="summary-label" text="Total Books" />
                              <Label fx:id="lblTotalBookCount" prefHeight="26.0" prefWidth="74.0" styleClass="summary-value" text="0" />
                           </children>
                        </VBox>
                        <VBox prefHeight="100.0" prefWidth="275.0" styleClass="summary-card">
                           <children>
                              <Label styleClass="summary-label" text="Available Books" />
                              <Label fx:id="lblAvailableBookCount" prefHeight="26.0" prefWidth="70.0" styleClass="summary-value" text="0" />
                           </children>
                        </VBox>
                        <VBox prefHeight="100.0" prefWidth="275.0" styleClass="summary-card">
                           <children>
                              <Label styleClass="summary-label" text="Issued Books" />
                              <Label fx:id="lblIssuedBookCount" prefHeight="26.0" prefWidth="80.0" styleClass="summary-value" text="0" />
                           </children>
                        </VBox>
                     </children>
                  </HBox>
                  <VBox prefHeight="234.0" prefWidth="830.0" styleClass="books-table-container">
                     <children>
                        <Label styleClass="table-section-title" text="Books List" />
                        <TableView fx:id="tblBook" prefHeight="178.0" prefWidth="791.0" styleClass="books-table">
                          <columns>
                            <TableColumn fx:id="clmBookId" prefWidth="95.9999840259552" text="Book ID" />
                            <TableColumn fx:id="clmBookTitle" prefWidth="180.79998779296875" text="Book Title" />
                              <TableColumn fx:id="clmAuthor" prefWidth="172.0" text="Author" />
                              <TableColumn fx:id="clmCategory" prefWidth="105.59991455078125" text="Category" />
                              <TableColumn fx:id="clmStatus" prefWidth="93.5999755859375" text="Status" />
                              <TableColumn fx:id="clmAction" prefWidth="142.39990234375" text="Actions" />
                          </columns>
                        </TableView>
                     </children>
                  </VBox>
               </children>
            </VBox>
         </center>
      </BorderPane>
   </children>
</AnchorPane>
