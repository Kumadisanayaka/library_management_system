<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<AnchorPane prefHeight="640.0" prefWidth="943.0" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="controller.issueBookController.Issue_page_controller">
   <children>
      <BorderPane prefHeight="770.0" prefWidth="1096.0" styleClass="issue-book-root" stylesheets="@../css/issue_book_page.css">
         <left>
            <VBox prefHeight="640.0" prefWidth="231.0" styleClass="sidebar" BorderPane.alignment="CENTER">
               <children>
                  <Label contentDisplay="CENTER" styleClass="logo-title" text="Library System" />
                  <VBox prefHeight="496.0" prefWidth="264.0" styleClass="navigation-menu">
                     <children>
                        <Button fx:id="btnDashboard" mnemonicParsing="false" onAction="#btnDashboardOnAction" prefHeight="23.0" prefWidth="243.0" styleClass="nav-button" text="Dashboard" />
                        <Button fx:id="btnAddBook" layoutX="10.0" layoutY="10.0" mnemonicParsing="false" onAction="#btnAddBookOnAction" prefHeight="23.0" prefWidth="243.0" styleClass="nav-button" text="Add Book" />
                        <Button fx:id="btnViewBook" layoutX="10.0" layoutY="40.0" mnemonicParsing="false" onAction="#btnViewBookOnAction" prefHeight="23.0" prefWidth="243.0" styleClass="nav-button" text="View Book" />
                        <Button fx:id="btnAddMember" layoutX="10.0" layoutY="69.0" mnemonicParsing="false" onAction="#btnAddMemberOnAction" prefHeight="23.0" prefWidth="243.0" styleClass="nav-button" text="Add Member" />
                        <Button fx:id="btnManageMembers" layoutX="10.0" layoutY="99.0" mnemonicParsing="false" onAction="#btnManageMembersOnAction" prefHeight="23.0" prefWidth="243.0" styleClass="nav-button" text="Manage Members" />
                        <Button fx:id="btnManageBooks" layoutX="10.0" layoutY="128.0" mnemonicParsing="false" onAction="#btnManageBooksOnAction" prefHeight="23.0" prefWidth="243.0" styleClass="nav-button" text="Manage Books" />
                        <Button fx:id="btnIssueBook" layoutX="10.0" layoutY="158.0" mnemonicParsing="false" onAction="#btnIssueBookOnAction" prefHeight="23.0" prefWidth="243.0" styleClass="nav-button-active" text="Issue Book" />
                        <Button fx:id="btnReturnBook" layoutX="10.0" layoutY="188.0" mnemonicParsing="false" onAction="#btnReturnBookOnAction" prefHeight="23.0" prefWidth="243.0" styleClass="nav-button" text="Return Book" />
                        <Button fx:id="btnHistory" layoutX="10.0" layoutY="217.0" mnemonicParsing="false" onAction="#btnHistoryOnAction" prefHeight="23.0" prefWidth="243.0" styleClass="nav-button" text="History" />
                     </children>
                  </VBox>
                  <Button fx:id="btnLogout" mnemonicParsing="false" onAction="#btnLogoutOnAction" prefHeight="23.0" prefWidth="243.0" styleClass="logout-button" text="Logout" />
               </children>
            </VBox>
         </left>
         <center>
            <VBox prefHeight="817.0" prefWidth="808.0" styleClass="content-area" BorderPane.alignment="CENTER">
               <children>
                  <HBox prefHeight="64.0" prefWidth="760.0" styleClass="top-bar">
                     <children>
                        <VBox prefHeight="64.0" prefWidth="226.0" styleClass="page-header">
                           <children>
                              <Label styleClass="page-title" text="Issue Book" />
                              <Label styleClass="page-subtitle" text="Issue books to library members" />
                           </children>
                        </VBox>
                        <Region prefHeight="64.0" prefWidth="250.0" />
                        <HBox prefHeight="64.0" prefWidth="225.0" styleClass="admin-profile">
                           <children>
                              <Label styleClass="admin-avatar" text="A" />
                              <VBox alignment="CENTER_LEFT" prefHeight="43.0" prefWidth="130.0" styleClass="admin-info">
                                 <children>
                                    <Label styleClass="admin-name" text="Admin" />
                                    <Label styleClass="admin-role" text="Administrator" />
                                 </children>
                              </VBox>
                           </children>
                        </HBox>
                     </children>
                  </HBox>
                  <HBox prefHeight="636.0" prefWidth="760.0" styleClass="issue-book-content">
                     <children>
                        <VBox prefHeight="646.0" prefWidth="743.0" styleClass="issue-form-container">
                           <children>
                              <Label styleClass="form-title" text="Issue a Book" />
                              <Label styleClass="form-subtitle" text="Select a member and an available book" />
                              <HBox prefHeight="38.0" prefWidth="706.0" styleClass="member-section-header">
                                 <children>
                                    <Label alignment="TOP_LEFT" styleClass="member-section-label" text="Member Details" />
                                 </children>
                              </HBox>
                              <Label styleClass="member-id-label" text="Member ID" />
                              <HBox prefHeight="41.0" prefWidth="694.0" styleClass="member-selection-row">
                                 <children>
                                    <ComboBox fx:id="cmbMemberId" prefWidth="502.0" promptText="Select Member ID" styleClass="member-id-combo" />
                                    <Button fx:id="btnGoAddMember" mnemonicParsing="false" onAction="#btnGoAddMemberOnAction" prefWidth="181.0" styleClass="add-member-button" text="+ Add Member" />
                                 </children>
                              </HBox>
                              <Label styleClass="member-name-label" text="Member Name" />
                              <TextField fx:id="txtMemberName" prefHeight="46.0" prefWidth="694.0" promptText="Member name will appear here" styleClass="member-name-field" />
                              <Label prefHeight="38.0" prefWidth="694.0" styleClass="book-section-label" text="Book Details" />
                              <Label styleClass="book-id-label" text="Book ID" />
                              <ComboBox fx:id="cmbBookId" prefHeight="33.0" prefWidth="241.0" promptText="Select Available Book" styleClass="book-id-combo" />
                              <Label styleClass="book-title-label" text="Book Title" />
                              <TextField fx:id="txtBookTitle" prefHeight="59.0" prefWidth="694.0" promptText="Book title will appear here" styleClass="book-title-field" />
                              <HBox prefHeight="70.0" prefWidth="694.0" styleClass="date-selection-row">
                                 <children>
                                    <VBox prefHeight="61.0" prefWidth="280.0" styleClass="date-field-group">
                                       <children>
                                          <Label styleClass="issue-date-label" text="Issue Date" />
                                          <DatePicker fx:id="datePickerIssueDate" prefHeight="23.0" prefWidth="261.0" styleClass="issue-date-picker" />
                                       </children>
                                    </VBox>
                                    <Region prefHeight="61.0" prefWidth="64.0" />
                                    <VBox prefHeight="61.0" prefWidth="296.0" styleClass="date-field-group">
                                       <children>
                                          <Label styleClass="due-date-label" text="Due Date" />
                                          <DatePicker fx:id="datePickerDueDate" prefHeight="38.0" prefWidth="290.0" styleClass="due-date-picker" />
                                       </children>
                                    </VBox>
                                 </children>
                              </HBox>
                              <Label prefHeight="29.0" prefWidth="694.0" styleClass="message-label" />
                              <HBox prefHeight="75.0" prefWidth="694.0" styleClass="form-actions">
                                 <children>
                                    <Button fx:id="btnClear" mnemonicParsing="false" onAction="#btnClearOnAction" prefWidth="117.0" styleClass="clear-button" text="Clear" />
                                    <Button fx:id="btnIssue" mnemonicParsing="false" onAction="#btnIssueOnAction" prefWidth="157.0" styleClass="issue-button" text="Issue Book" />
                                 </children>
                              </HBox>
                           </children>
                        </VBox>
                     </children>
                  </HBox>
               </children>
            </VBox>
         </center>
      </BorderPane>
   </children>
</AnchorPane>
