                              <Label alignment="CENTER" contentDisplay="CENTER" maxHeight="62.0" maxWidth="65.0" prefHeight="62.0" prefWidth="36.0" styleClass="admin-avatar" stylesheets="@../css/dashboard.css" text="A" />
