<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<AnchorPane prefHeight="334.0" prefWidth="481.0" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="controller.addBookController.Add_book_page_controller">
   <children>
      <VBox prefHeight="698.0" prefWidth="622.0" styleClass="add-book-page" stylesheets="@../css/style.css">
         <children>
            <Label alignment="CENTER" prefHeight="74.0" prefWidth="656.0" style="-fx-background-color: #FFF2A0;" styleClass="add-book-title" text="Add New Book">
               <font>
                  <Font name="Arial Black" size="30.0" />
               </font>
               <VBox.margin>
                  <Insets bottom="10.0" left="10.0" right="10.0" top="10.0" />
               </VBox.margin>
               <padding>
                  <Insets bottom="10.0" left="10.0" right="10.0" top="10.0" />
               </padding>
            </Label>
            <VBox prefHeight="390.0" prefWidth="656.0" styleClass="book-form" stylesheets="@../css/style.css">
               <children>
                  <Label prefHeight="18.0" prefWidth="106.0" text="Book ID" />
                  <TextField fx:id="txtBookId" />
                  <Label layoutX="10.0" layoutY="10.0" prefHeight="18.0" prefWidth="106.0" text="Book Title" />
                  <TextField fx:id="txtBookTitle" layoutX="10.0" layoutY="28.0" />
                  <Label layoutX="36.0" layoutY="128.0" prefHeight="18.0" prefWidth="106.0" text="Author" />
                  <TextField fx:id="txtAuthor" layoutX="36.0" layoutY="163.0" prefHeight="41.0" prefWidth="327.0" />
                  <Label layoutX="36.0" layoutY="219.0" prefHeight="18.0" prefWidth="106.0" text="Category" />
                  <ComboBox fx:id="cbCategory" editable="true" prefHeight="27.0" prefWidth="539.0" promptText="Select Category" />
                  <Label layoutX="36.0" layoutY="310.0" prefHeight="18.0" prefWidth="106.0" text="Published Year" />
                  <TextField fx:id="txtPublishedYear" layoutX="36.0" layoutY="345.0" />
                  <Label layoutX="36.0" layoutY="401.0" prefHeight="18.0" prefWidth="106.0" text="Quantity" />
                  <TextField fx:id="txtQuantity" layoutX="36.0" layoutY="436.0" />
               </children>
            </VBox>
            <HBox alignment="CENTER" prefHeight="105.0" prefWidth="595.0" spacing="10.0" styleClass="button-container" stylesheets="@../css/style.css">
               <children>
                  <Button fx:id="btnAdd" mnemonicParsing="false" onAction="#addOnAction" styleClass="add-book-btn" stylesheets="@../css/style.css" text="Add" />
                  <Button fx:id="btnClear" mnemonicParsing="false" onAction="#clearOnAction" styleClass="clear-book-btn" stylesheets="@../css/style.css" text="Clear">
                     <font>
                        <Font name="System Bold" size="12.0" />
                     </font>
                  </Button>
                  <Button fx:id="btnBack" alignment="CENTER" contentDisplay="RIGHT" mnemonicParsing="false" onAction="#backOnAction" styleClass="back-btn" stylesheets="@../css/style.css" text="Back" />
               </children>
            </HBox>
         </children>
      </VBox>
   </children>
</AnchorPane>
