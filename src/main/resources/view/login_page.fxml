      <Label layoutX="52.0" layoutY="38.0" prefHeight="70.0" prefWidth="125.0" text="Login">
         <font>
            <Font name="Century" size="44.0" />
         </font>
      </Label>
      <Label fx:id="lbluname" layoutX="50.0" layoutY="129.0" text="Username" />
      <TextField fx:id="txtusername" layoutX="113.0" layoutY="125.0" prefHeight="26.0" prefWidth="184.0" />
      <Label fx:id="lblpassword" layoutX="50.0" layoutY="170.0" text="Password" />
      <PasswordField fx:id="txtpassword" layoutX="114.0" layoutY="166.0" prefHeight="26.0" prefWidth="184.0" />
      <Button fx:id="btnlogin" layoutX="50.0" layoutY="250.0" mnemonicParsing="false" onAction="#loginOnAction" prefHeight="26.0" prefWidth="150.0" style="-fx-background-color: #F15025;" text="Login" textFill="WHITE" />
      <Button fx:id="btnreset" layoutX="205.0" layoutY="250.0" mnemonicParsing="false" onAction="#resetOnAction" prefHeight="26.0" prefWidth="98.0" style="-fx-background-color: #7D9C65;" text="Reset" textFill="WHITE" />
