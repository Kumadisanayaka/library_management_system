<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<AnchorPane prefHeight="550.0" prefWidth="1089.0" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="controller.viewBooksController.View_books_page_controller">
   <children>
      <BorderPane prefHeight="656.0" prefWidth="1361.0" styleClass="view-books-root" stylesheets="@../css/view_books_page.css">
         <left>
            <VBox prefHeight="548.0" prefWidth="217.0" styleClass="sidebar" BorderPane.alignment="CENTER">
               <children>
                  <Label styleClass="logo-title" text="Library System" />
                  <VBox prefHeight="377.0" prefWidth="181.0" styleClass="navigation-menu">
                     <children>
                        <Button fx:id="btnDashboard" mnemonicParsing="false" onAction="#btnDashboardOnAction" prefHeight="42.0" prefWidth="170.0" styleClass="nav-button" text="Dashboard" />
                        <Button fx:id="btnAddBook" layoutX="10.0" layoutY="10.0" mnemonicParsing="false" onAction="#btnAddBookOnAction" prefHeight="42.0" prefWidth="170.0" styleClass="nav-button" text="Add Book" />
                        <Button fx:id="btnViewBook" layoutX="10.0" layoutY="59.0" mnemonicParsing="false" onAction="#btnViewBookOnAction" prefHeight="42.0" prefWidth="170.0" styleClass="nav-button-active" text="View Books" />
                        <Button fx:id="btnAddMember" layoutX="10.0" layoutY="108.0" mnemonicParsing="false" onAction="#btnAddMemberOnAction" prefHeight="42.0" prefWidth="170.0" styleClass="nav-button" text="Add Member" />
                        <Button fx:id="btnManageMember" layoutX="10.0" layoutY="156.0" mnemonicParsing="false" onAction="#btnManageMemberOnAction" prefHeight="42.0" prefWidth="170.0" styleClass="nav-button" text="Manage Members" />
                        <Button fx:id="btnManageBooks" layoutX="10.0" layoutY="202.0" mnemonicParsing="false" onAction="#btnManageBooksOnAction" prefHeight="42.0" prefWidth="170.0" styleClass="nav-button" text="Manage Books" />
                        <Button fx:id="btnIssueBook" layoutX="10.0" layoutY="205.0" mnemonicParsing="false" onAction="#btnIssueBookOnAction" prefHeight="42.0" prefWidth="170.0" styleClass="nav-button" text="Issue Book" />
                        <Button fx:id="btnReturnBook" layoutX="10.0" layoutY="254.0" mnemonicParsing="false" onAction="#btnReturnBookOnAction" prefHeight="42.0" prefWidth="170.0" styleClass="nav-button" text="Return Book" />
                        <Button fx:id="btnHistory" layoutX="10.0" layoutY="303.0" mnemonicParsing="false" onAction="#btnHistoryOnAction" prefHeight="42.0" prefWidth="170.0" styleClass="nav-button" text="History" />
                     </children>
                  </VBox>
                  <Button fx:id="btnLogout" mnemonicParsing="false" onAction="#btnLogoutOnAction" prefHeight="42.0" prefWidth="172.0" styleClass="logout-button" text="Logout" />
               </children>
            </VBox>
         </left>
         <center>
            <VBox prefHeight="549.0" prefWidth="737.0" styleClass="content-area" BorderPane.alignment="CENTER">
               <children>
                  <HBox prefHeight="74.0" prefWidth="543.0" styleClass="top-bar">
                     <children>
                        <VBox prefHeight="74.0" prefWidth="230.0" styleClass="page-header">
                           <children>
                              <Label styleClass="page-title" text="View Books" />
                              <Label styleClass="page-subtitle" text="Search and manage books in the library" />
                           </children>
                        </VBox>
                        <Region prefHeight="74.0" prefWidth="615.0" />
                        <HBox prefHeight="100.0" prefWidth="200.0" styleClass="admin-profile">
                           <children>
                              <Label styleClass="admin-avatar" text="A" />
                              <VBox alignment="CENTER_LEFT" prefHeight="58.0" prefWidth="154.0" styleClass="admin-info">
                                 <children>
                                    <Label styleClass="admin-name" text="Admin" />
                                    <Label styleClass="admin-role" text="Administrator" />
                                 </children>
                              </VBox>
                           </children>
                        </HBox>
                     </children>
                  </HBox>
                  <HBox prefHeight="60.0" prefWidth="543.0" styleClass="search-bar">
                     <children>
                        <TextField fx:id="txtSearch" onAction="#txtSearchOnAction" onDragEntered="#txtSearchEnteredOnAction" onKeyTyped="#txtSearchTypeOnAction" prefHeight="42.0" prefWidth="790.0" promptText="Search by title, author or ISBN..." styleClass="search-field" />
                        <Region prefHeight="59.0" prefWidth="29.0" />
                        <Region prefHeight="60.0" prefWidth="0.0" />
                        <Button fx:id="btnSearch" mnemonicParsing="false" onAction="#btnSearchOnAction" prefHeight="40.0" prefWidth="178.0" styleClass="search-button" text="Search" />
                     </children>
                  </HBox>
                  <HBox prefHeight="100.0" prefWidth="200.0" styleClass="filter-bar">
                     <children>
                        <VBox prefHeight="100.0" prefWidth="281.0" styleClass="filter-section">
                           <children>
                              <Label styleClass="filter-label" text="Category" />
                              <ComboBox fx:id="cmbCategory" prefWidth="260.0" promptText="Select Category" styleClass="filter-combo" />
                           </children>
                        </VBox>
                        <Region prefHeight="100.0" prefWidth="44.0" />
                        <VBox prefHeight="100.0" prefWidth="281.0" styleClass="filter-section">
                           <children>
                              <Label styleClass="filter-label" text="Availability" />
                              <ComboBox fx:id="cmbAvailability" prefWidth="276.0" promptText="Select Availability" styleClass="filter-combo" />
                           </children>
                        </VBox>
                        <Region prefHeight="100.0" prefWidth="36.0" styleClass="filter-section" />
                        <VBox prefHeight="100.0" prefWidth="281.0" styleClass="filter-section">
                           <children>
                              <Label styleClass="filter-label" text="Sort By" />
                              <ComboBox fx:id="cmbSortBy" prefWidth="278.0" promptText="Select Sort by" styleClass="filter-combo" />
                           </children>
                        </VBox>
                     </children>
                  </HBox>
                  <HBox prefHeight="47.0" prefWidth="802.0" styleClass="books-summary">
                     <children>
                        <Label alignment="CENTER" contentDisplay="CENTER" prefHeight="18.0" prefWidth="93.0" styleClass="books-count-title" text="Total Books: " />
                        <Label fx:id="lblTotalCount" styleClass="books-count-value" text="0" />
                        <Region prefHeight="38.0" prefWidth="714.0" />
                        <Button fx:id="btnResetFilter" mnemonicParsing="false" onAction="#btnResetFilterOnAction" prefHeight="38.0" prefWidth="192.0" styleClass="reset-filter-button" text="Reset Filters" />
                     </children>
                  </HBox>
                  <TableView fx:id="tblViewBooks" prefHeight="200.0" prefWidth="200.0" styleClass="books-table" stylesheets="@../css/view_books_page.css">
                     <columns>
                        <TableColumn fx:id="idColumn" prefWidth="86.39998173713684" styleClass="-fx-alignment: CENTER;" text="Book ID" />
                        <TableColumn fx:id="bookTitleColumn" prefWidth="207.19998931884766" styleClass="-fx-alignment: CENTER;" text="Book Title" />
                        <TableColumn fx:id="authorColumn" prefWidth="163.20001220703125" styleClass="-fx-alignment: CENTER;" text="Author" />
                        <TableColumn fx:id="isbnColumn" prefWidth="149.60006713867188" styleClass="-fx-alignment: CENTER;" text="ISBN" />
                        <TableColumn fx:id="categoryColumn" prefWidth="136.0" styleClass="-fx-alignment: CENTER;" text="Category" />
                        <TableColumn fx:id="totalCopiesColumn" prefWidth="102.39996337890625" styleClass="-fx-alignment: CENTER;" text="Total Copies" />
                        <TableColumn fx:id="availableCopiesColumn" prefWidth="129.5999755859375" styleClass="-fx-alignment: CENTER;" text="Available Copies" />
                        <TableColumn fx:id="statusColomn" prefWidth="92.80010986328125" styleClass="-fx-alignment: CENTER;" text="Status" />
                     </columns>
                  </TableView>
               </children>
            </VBox>
         </center>
      </BorderPane>
   </children>
</AnchorPane>
