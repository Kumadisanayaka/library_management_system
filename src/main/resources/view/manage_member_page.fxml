                        <Button fx:id="btnSearch" mnemonicParsing="false" onAction="#btnSearchOnAction" styleClass="search-button" text="Search" />
                        <Region prefHeight="66.0" prefWidth="26.0" />
                        <ComboBox fx:id="cmbCategory" prefWidth="150.0" styleClass="filter-combo" />
                        <Region prefHeight="66.0" prefWidth="35.0" />
                        <Button fx:id="btnResetFilters" mnemonicParsing="false" onAction="#btnResetFiltersOnAction" styleClass="reset-filter-button" text="Reset Filters" />
                     </children>
                     <VBox.margin>
                        <Insets />
                     </VBox.margin></HBox>
                  <HBox prefHeight="53.0" prefWidth="756.0" styleClass="member-summary">
                     <children>
                        <VBox minHeight="67.0" prefHeight="100.0" prefWidth="261.0" styleClass="member-summary-card">
                           <children>
                              <Label alignment="CENTER" contentDisplay="CENTER" styleClass="summary-label" text="Total Members" />
                              <Label fx:id="lblTotalMembersCount" styleClass="summary-value" text="0" />
                           </children>
                        </VBox>
                        <VBox prefHeight="100.0" prefWidth="265.0" styleClass="member-summary-card">
                           <children>
                              <Label styleClass="summary-label" text="Student Members" />
                              <Label fx:id="lblStudentMembersCount" styleClass="summary-value" text="0" />
                           </children>
                        </VBox>
                        <VBox prefHeight="100.0" prefWidth="266.0" styleClass="member-summary-card">
                           <children>
                              <Label styleClass="summary-label" text="Other Members" />
                              <Label fx:id="lblOtherMembersCount" styleClass="summary-value" text="0" />
                           </children>
                        </VBox>
                     </children>
                     <VBox.margin>
                        <Insets top="10.0" />
                     </VBox.margin>
                  </HBox>
                  <VBox prefHeight="266.0" prefWidth="824.0" styleClass="members-table-container">
                     <VBox.margin>
                        <Insets top="10.0" />
                     </VBox.margin>
                     <children>
                        <Label styleClass="table-section-title" text="Member List" />
                        <TableView prefHeight="198.0" prefWidth="782.0" styleClass="members-table">
                           <columns>
                              <TableColumn fx:id="clmMemberId" prefWidth="91.99996638298035" text="Member ID" />
                              <TableColumn fx:id="clmFullName" prefWidth="144.79995727539062" text="Full Name" />
                              <TableColumn fx:id="clmPhone" prefWidth="111.20002746582031" text="Phone" />
                              <TableColumn fx:id="clmCategory" prefWidth="92.800048828125" text="Category" />
                              <TableColumn fx:id="clmEmail" prefWidth="172.00003051757812" text="Email" />
                              <TableColumn fx:id="clmAction" prefWidth="164.79996337890623" text="Action" />
                           </columns>
                        </TableView>
                     </children>
                  </VBox>
               </children>
            </VBox>
