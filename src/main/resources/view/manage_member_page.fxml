<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>


<AnchorPane prefHeight="510.0" prefWidth="742.0" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="controller.Manage_member_Page_controller">
   <children>
      <BorderPane prefHeight="551.0" prefWidth="742.0">
         <top>
            <VBox prefHeight="63.0" prefWidth="742.0" style="-fx-background-color: #FFF2A0;" styleClass="main-header" stylesheets="@../css/style.css" BorderPane.alignment="CENTER">
               <children>
                  <Label styleClass="main-title" stylesheets="@../css/style.css" text="Manage Members">
                     <font>
                        <Font name="Arial Black" size="30.0" />
                     </font>
                  </Label>
                  <Label styleClass="main-subtitle" text="View and manage registered library members">
                     <font>
                        <Font size="18.0" />
                     </font>
                  </Label>
               </children>
            </VBox>
         </top>
         <center>
            <VBox prefHeight="200.0" prefWidth="100.0" BorderPane.alignment="CENTER">
               <children>
                  <HBox prefHeight="100.0" prefWidth="200.0" styleClass="search-container" stylesheets="@../css/style.css">
                     <children>
                        <TextField fx:id="searchField" onAction="#searchInputOnAction" prefHeight="42.0" prefWidth="600.0" promptText="search members..." styleClass="search-field" stylesheets="@../css/style.css" />
                        <Button fx:id="searchBtn" mnemonicParsing="false" onAction="#searchBtnOnAction" styleClass="search-btn" stylesheets="@../css/style.css" text="Search" />
                     </children>
                     <VBox.margin>
                        <Insets left="10.0" />
                     </VBox.margin>
                  </HBox>
                  <TableView fx:id="memberTbl" editable="true" prefHeight="204.0" prefWidth="659.0" styleClass="member-table" stylesheets="@../css/style.css">
                    <columns>
                        <TableColumn fx:id="memberIdCol" prefWidth="126.39999079704285" text="Member ID" />
                        <TableColumn fx:id="fullNameCol" prefWidth="106.4000244140625" text="Full Name" />
                        <TableColumn fx:id="addressCol" prefWidth="125.59999084472656" text="Address" />
                        <TableColumn fx:id="emailCol" prefWidth="141.60003662109375" text="Email" />
                        <TableColumn fx:id="phoneNumberCol" minWidth="4.7999267578125" prefWidth="112.0" text="Phone Number" />
                        <TableColumn fx:id="actionCol" prefWidth="129.60001220703123" text="Actions" />
                    </columns>
                     <VBox.margin>
                        <Insets bottom="5.0" left="5.0" right="5.0" top="5.0" />
                     </VBox.margin>
                  </TableView>
               </children>
            </VBox>
         </center>
         <bottom>
            <HBox alignment="CENTER" prefHeight="100.0" prefWidth="200.0" spacing="10.0" styleClass="member-action-container" BorderPane.alignment="CENTER">
               <children>
                  <Button fx:id="editMemberBtn" mnemonicParsing="false" onAction="#editMemberBtnOnAction" styleClass="edit-member-btn" stylesheets="@../css/style.css" text="Edit Member" HBox.hgrow="ALWAYS">
                     <HBox.margin>
                        <Insets bottom="10.0" left="10.0" right="10.0" top="10.0" />
                     </HBox.margin>
                  </Button>
                  <Button fx:id="deleteMemberBtn" mnemonicParsing="false" onAction="#deleteMemberBtnOnAction" styleClass="delete-member-btn" stylesheets="@../css/style.css" text="Delete Member" HBox.hgrow="ALWAYS">
                     <HBox.margin>
                        <Insets bottom="10.0" left="10.0" right="10.0" top="10.0" />
                     </HBox.margin>
                  </Button>
               </children>
               <padding>
                  <Insets bottom="5.0" left="5.0" right="5.0" top="5.0" />
               </padding>
            </HBox>
         </bottom>
      </BorderPane>
   </children>
</AnchorPane>
