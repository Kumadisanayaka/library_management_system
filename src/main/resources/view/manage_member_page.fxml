                     <children>
                        <Button fx:id="btnDashboard" mnemonicParsing="false" onAction="#btnDashboardOnAction" prefHeight="38.0" prefWidth="207.0" styleClass="nav-button" text="Dashboard" />
                        <Button fx:id="btnAddBook" layoutX="10.0" layoutY="18.0" mnemonicParsing="false" onAction="#btnAddBookOnAction" prefHeight="38.0" prefWidth="206.0" styleClass="nav-button" text="Add Book" />
                        <Button fx:id="btnViewBooks" layoutX="10.0" layoutY="41.0" mnemonicParsing="false" onAction="#btnViewBooksOnAction" prefHeight="38.0" prefWidth="208.0" styleClass="nav-button" text="View Books" />
                        <Button fx:id="btnAddMember" layoutX="10.0" layoutY="64.0" mnemonicParsing="false" onAction="#btnAddMemberOnAction" prefHeight="38.0" prefWidth="206.0" styleClass="nav-button" text="Add Member" />
                        <Button fx:id="btnManageMembers" layoutX="10.0" layoutY="88.0" mnemonicParsing="false" onAction="#btnManageMembersOnAction" prefHeight="38.0" prefWidth="206.0" styleClass="nav-button-active" text="Manage Members" />
                        <Button fx:id="btnManageBooks" layoutX="10.0" layoutY="189.0" mnemonicParsing="false" onAction="#btnManageBooksOnAction" prefHeight="38.0" prefWidth="206.0" styleClass="nav-button" text="Manage Books" />
                        <Button fx:id="btnIssueBook" layoutX="10.0" layoutY="111.0" mnemonicParsing="false" onAction="#btnIssueBookOnAction" prefHeight="38.0" prefWidth="205.0" styleClass="nav-button" text="Issue Book" />
                        <Button fx:id="btnReturnBook" layoutX="10.0" layoutY="134.0" mnemonicParsing="false" onAction="#btnReturnBookOnAction" prefHeight="38.0" prefWidth="207.0" styleClass="nav-button" text="Return Book" />
                        <Button fx:id="btnHistory" layoutX="10.0" layoutY="157.0" mnemonicParsing="false" onAction="#btnHistoryOnAction" prefHeight="38.0" prefWidth="206.0" styleClass="nav-button" text="History" />
                     </children>
                  </VBox>
                  <Button fx:id="btnLogout" mnemonicParsing="false" onAction="#btnLogoutOnAction" prefHeight="38.0" prefWidth="210.0" styleClass="logout-button" text="Logout" />
               </children>
            </VBox>
         </left>
         <center>
            <VBox prefHeight="200.0" prefWidth="100.0" styleClass="content-area" BorderPane.alignment="CENTER">
               <children>
                  <HBox prefHeight="62.0" prefWidth="630.0" styleClass="top-bar">
                     <children>
                        <VBox prefHeight="92.0" prefWidth="222.0">
                           <children>
                              <Label styleClass="page-title" text="Manage Members" />
                              <Label styleClass="page-subtitle" text="View and manage library members" />
                           </children>
                        </VBox>
                        <Region prefHeight="54.0" prefWidth="358.0" />
                        <HBox alignment="CENTER" prefHeight="92.0" prefWidth="246.0" styleClass="admin-profile">
                           <children>
                              <Label styleClass="admin-avatar" text="A">
                                 <HBox.margin>
                                    <Insets />
                                 </HBox.margin>
                              </Label>
                              <VBox alignment="CENTER_LEFT" prefHeight="70.0" prefWidth="175.0" styleClass="admin-info">
                                 <children>
                                    <Label styleClass="admin-name" text="Admin" />
