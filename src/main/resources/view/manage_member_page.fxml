<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<AnchorPane prefHeight="615.0" prefWidth="935.0" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="controller.manageMemberController.Manage_member_Page_controller">
   <children>
      <BorderPane prefHeight="615.0" prefWidth="1129.0" styleClass="manage-members-root" stylesheets="@../css/manage_member_page.css">
         <left>
            <VBox prefHeight="615.0" prefWidth="249.0" styleClass="sidebar" BorderPane.alignment="CENTER">
               <children>
                  <Label styleClass="logo-title" text="Library System" />
