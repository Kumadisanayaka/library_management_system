                        <VBox prefHeight="200.0" prefWidth="100.0" styleClass="stat-card">
                           <children>
                              <Label text="Total Books" />
                              <Label fx:id="lblTotalBook" text="0" />
                           </children>
                        </VBox>
                        <VBox prefHeight="200.0" prefWidth="100.0" styleClass="stat-card">
                           <children>
                              <Label text="Total Members" />
