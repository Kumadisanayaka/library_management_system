                  <Button fx:id="btnReturnBook" mnemonicParsing="false" onAction="#btnReturnBookOnAction" prefHeight="23.0" prefWidth="170.0" styleClass="nav-button" text="Return Book" />
                  <Button fx:id="btnHistory" mnemonicParsing="false" onAction="#btnHistoryOnAction" prefHeight="23.0" prefWidth="172.0" styleClass="nav-button" text="History" />
                  <Button fx:id="btnLogout" mnemonicParsing="false" onAction="#btnLogoutOnAction" styleClass="nav-button" text="Logout" />
               </children>
            </VBox>
         </left>
         <center>
            <VBox prefHeight="591.0" prefWidth="725.0" styleClass="dashboard-content" BorderPane.alignment="CENTER">
               <children>
                  <HBox prefHeight="48.0" prefWidth="586.0" styleClass="top-bar">
                     <children>
                        <Label prefHeight="30.0" prefWidth="231.0" styleClass="page-title" text="Dashboard" />
                        <Region prefHeight="38.0" prefWidth="269.0" />
                        <HBox prefHeight="100.0" prefWidth="200.0" styleClass="admin-profile">
                           <children>
                              <Label styleClass="admin-avatar" text="A" />
                              <VBox prefHeight="200.0" prefWidth="100.0">
                                 <children>
                                    <Label styleClass="admin-name" text="Admin" />
                                    <Label styleClass="admin-role" text="Administrator" />
                                 </children>
                              </VBox>
                           </children>
                        </HBox>
                     </children>
                  </HBox>
                  <HBox prefHeight="100.0" prefWidth="200.0" styleClass="stats-container">
