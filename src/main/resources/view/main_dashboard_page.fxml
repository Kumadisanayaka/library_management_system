                              <TableColumn fx:id="clmBookTitle" prefWidth="228.80004960298538" text="Book Title" />
                              <TableColumn fx:id="clmMember" prefWidth="121.60000610351562" text="Member" />
                              <TableColumn fx:id="clmIssueDate" prefWidth="91.20001220703125" text="Issue Date" />
                              <TableColumn fx:id="clmDueDate" prefWidth="104.79995727539062" text="Due Date" />
                              <TableColumn fx:id="clmStatus" prefWidth="87.99993896484375" text="Status" />
                           </columns>
                        </TableView>
                     </children>
                  </VBox>
               </children>
            </VBox>
         </center>
      </BorderPane>
   </children>
