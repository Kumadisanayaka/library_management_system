               <children>
                  <Label alignment="CENTER" prefHeight="35.0" prefWidth="175.0" styleClass="sidebar-title" text="Library System" />
                  <Button fx:id="btnDashboard" mnemonicParsing="false" onAction="#btnDashboardOnAction" prefHeight="23.0" prefWidth="213.0" styleClass="nav-button-active" text="Dashboard" />
                  <Button fx:id="btnAddbook" mnemonicParsing="false" onAction="#btnAddbookOnAction" prefHeight="23.0" prefWidth="173.0" styleClass="nav-button" text="Add Book" />
                  <Button fx:id="btnViewBooks" mnemonicParsing="false" onAction="#btnViewBooksOnAction" prefHeight="23.0" prefWidth="172.0" styleClass="nav-button" text="View Books" />
                  <Button fx:id="btnAddMember" mnemonicParsing="false" onAction="#btnAddMemberOnAction" prefHeight="23.0" prefWidth="170.0" styleClass="nav-button" text="Add Member" />
